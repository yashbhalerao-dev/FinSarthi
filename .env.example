# FinSarthi environment template — copy to .env and fill locally.
# Never commit real API keys or credentials.

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# SQLite-compatible prototype store (PostgreSQL-compatible URL shape is fine later)
DATABASE_URL=sqlite:///./finsarthi.db

# Local document storage abstraction (not production object storage)
UPLOAD_DIR=./uploads

OCR_PROVIDER=local

# Pinecone (optional; local corpus retriever is used when empty)
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_ENVIRONMENT=

# Evidence-grounded LLM (optional; template explanations used when empty)
LLM_API_KEY=
LLM_MODEL=

# Optional embedding provider used by LangChain later
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
