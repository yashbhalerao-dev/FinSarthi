# Keep data directory layout without committing corpus binaries by default
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/schemes/*
!data/schemes/.gitkeep
data/metadata/*
!data/metadata/.gitkeep

